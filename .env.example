POSTGRES_DB=mobility
POSTGRES_USER=mobility
# make setup generates missing passwords in .env; never commit that file.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

MINIO_ROOT_USER=mobility_admin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Commands run on the host reach MinIO here, so the port follows MINIO_API_PORT.
# Without S3_ENDPOINT_URL, the S3 client uses AWS S3 and its credential chain.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=mobility
S3_REGION=us-east-1

AIRFLOW_PORT=8080
AIRFLOW_JWT_SECRET=
